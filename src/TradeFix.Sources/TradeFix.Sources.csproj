<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TradeFix.Shared\TradeFix.Shared.csproj" />
    <ProjectReference Include="..\TradeFix.Common\TradeFix.Common.csproj" />
    <ProjectReference Include="..\TradeFix.Network\TradeFix.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GDI BitBlt + DrawIconEx for screen capture (see ScreenCaptureService remarks for why,
         over Windows.Graphics.Capture) needs System.Drawing.Common for GDI/JPEG encoding. -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

</Project>
