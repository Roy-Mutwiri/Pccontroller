<Window x:Class="TradeFix.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TradeFix.Agent"
        xmlns:conv="clr-namespace:TradeFix.Agent.Converters"
        xmlns:vm="clr-namespace:TradeFix.Agent.ViewModels"
        mc:Ignorable="d"
        Title="TradeFix Render Agent" Height="640" Width="520" MinHeight="560" MinWidth="460"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="Manual"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
        <conv:ConnectionStateToBrushConverter x:Key="StateBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Background="{StaticResource Brush.WindowBackdrop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="3" Fill="{StaticResource Brush.AmbientGlow}" IsHitTestVisible="False" />
        <Rectangle Grid.RowSpan="3" Fill="{StaticResource Brush.GridOverlay}" IsHitTestVisible="False" />

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}">
            <Grid>
                <TextBlock Text="TradeFix Render Agent" Style="{StaticResource Text.Title}" Margin="20,12" />
                <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource Brush.AccentLine}">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
                    </Border.Effect>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20">

            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="18" ShadowDepth="0" Opacity="0.12" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <!-- The pulse is a liveness signal — a dead Offline/Error dot sits still
                             instead of breathing like a healthy live indicator. The exit action
                             starts a short to-1 animation, which takes over the property from
                             the infinite pulse (WPF last-writer-wins on animated properties). -->
                        <Ellipse Width="12" Height="12" Fill="{Binding State, Converter={StaticResource StateBrush}}"
                                 VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatePulses}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                                                                          Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding State}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ConnectedMasterSummary, StringFormat='Master: {0}'}" Style="{StaticResource Text.Secondary}"
                               Visibility="{Binding ConnectedMasterSummary, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding NodeId, StringFormat='Node ID: {0}'}" Style="{StaticResource Text.Secondary}"
                               Visibility="{Binding NodeId, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding VideoStats}" Foreground="{StaticResource Brush.Success}"
                               FontWeight="SemiBold" Margin="0,6,0,0"
                               Visibility="{Binding VideoStats, Converter={StaticResource NullToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Log Out from Master" Command="{Binding LogoutCommand}"
                                Visibility="{Binding KnowsMaster, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,10,0" />
                        <Button Content="Switch This PC to Master" Command="{Binding SwitchToMasterCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- First-time setup only: once paired, this Agent reconnects automatically on every
                 launch and this panel never shows again. -->
            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0"
                    Visibility="{Binding KnowsMaster, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="Connect to Master" Style="{StaticResource Text.Heading}" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,4" />
                    <TextBlock Text="Paste the connect code copied from the Master's &quot;Pair New Node&quot; panel:"
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBox Text="{Binding ConnectCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="16" Margin="0,0,0,6" Padding="8" />
                    <TextBlock Text="{Binding ConnectCodeError}" Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ConnectCodeError, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Text="This PC's node name" Style="{StaticResource Text.Secondary}" />
                    <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" Padding="6" />

                    <Button Content="Connect" Style="{StaticResource Button.Primary}" Command="{Binding ConnectWithCodeCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Fallback: shown if the code parsed from the connect string above wasn't accepted
                 (e.g. it expired between copy and paste) — get a fresh one from Master and retype it here. -->
            <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Accent}"
                    BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0"
                    Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Pairing}">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="20" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Waiting for a pairing code. If this doesn't clear on its own within a few seconds, get a fresh code from the Master and enter it here:" TextWrapping="Wrap" />
                    <TextBox Text="{Binding PairingCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="18" Margin="0,10,0,10" Padding="8" />
                    <Button Content="Submit Code" Style="{StaticResource Button.Primary}"
                            Command="{Binding SubmitPairingCodeCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Brush.AccentLine}" Opacity="0.5" />
                <DockPanel Margin="20,10">
                    <TextBlock Text="LOGS" Style="{StaticResource Text.Eyebrow}" DockPanel.Dock="Top" Margin="0,0,0,6" />
                    <ListBox x:Name="LogList" ItemsSource="{Binding RecentLogLines}" FontFamily="Consolas" FontSize="11" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
