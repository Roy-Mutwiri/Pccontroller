<Window x:Class="TradeFix.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TradeFix.Agent"
        xmlns:conv="clr-namespace:TradeFix.Agent.Converters"
        xmlns:vm="clr-namespace:TradeFix.Agent.ViewModels"
        mc:Ignorable="d"
        Title="TradeFix Render Agent" Height="640" Width="520"
        WindowStartupLocation="Manual"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
        <conv:ConnectionStateToBrushConverter x:Key="StateBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <TextBlock Text="TradeFix Render Agent" FontWeight="Bold" FontSize="16" Margin="16,10" />
        </Border>

        <StackPanel Grid.Row="1" Margin="20">

            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Ellipse Width="12" Height="12" Fill="{Binding State, Converter={StaticResource StateBrush}}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding State}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ConnectedMasterSummary, StringFormat='Master: {0}'}" Style="{StaticResource Text.Secondary}"
                               Visibility="{Binding ConnectedMasterSummary, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding NodeId, StringFormat='Node ID: {0}'}" Style="{StaticResource Text.Secondary}"
                               Visibility="{Binding NodeId, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- First-time setup only: once paired, this Agent reconnects automatically on every
                 launch and this panel never shows again. -->
            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,14,0,0"
                    Visibility="{Binding KnowsMaster, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="Connect to Master" Style="{StaticResource Text.Heading}" Margin="0,0,0,4" />
                    <TextBlock Text="Paste the connect code copied from the Master's &quot;Pair New Node&quot; panel:"
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBox Text="{Binding ConnectCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="16" Margin="0,0,0,6" Padding="8" />
                    <TextBlock Text="{Binding ConnectCodeError}" Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ConnectCodeError, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Text="This PC's node name" Style="{StaticResource Text.Secondary}" />
                    <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" Padding="6" />

                    <Button Content="Connect" Style="{StaticResource Button.Primary}" Command="{Binding ConnectWithCodeCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Fallback: shown if the code parsed from the connect string above wasn't accepted
                 (e.g. it expired between copy and paste) — get a fresh one from Master and retype it here. -->
            <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Accent}"
                    BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,14,0,0"
                    Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Pairing}">
                <StackPanel>
                    <TextBlock Text="Waiting for a pairing code. If this doesn't clear on its own within a few seconds, get a fresh code from the Master and enter it here:" TextWrapping="Wrap" />
                    <TextBox Text="{Binding PairingCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="18" Margin="0,10,0,10" Padding="8" />
                    <Button Content="Submit Code" Style="{StaticResource Button.Primary}"
                            Command="{Binding SubmitPairingCodeCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,10">
                <TextBlock Text="LOGS" Style="{StaticResource Text.Secondary}" DockPanel.Dock="Top" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding RecentLogLines}" FontFamily="Consolas" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
