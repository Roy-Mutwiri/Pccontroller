<Window x:Class="TradeFix.Agent.RenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:TradeFix.Agent.Converters"
        xmlns:vm="clr-namespace:TradeFix.Agent.ViewModels"
        mc:Ignorable="d"
        Title="TradeFix Render Output" Height="608" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        d:DataContext="{d:DesignInstance vm:RenderViewModel}">

    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSource" />

        <DataTemplate x:Key="RenderSourceTemplate" DataType="{x:Type vm:RenderSourceItemViewModel}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Border Background="{Binding ColorHex, Converter={StaticResource HexColorToBrush}}"
                        Visibility="{Binding IsColor, Converter={StaticResource BoolToVisibility}}" />
                <Border Background="#AA000000" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding TextContent}" Foreground="{Binding ColorHex, Converter={StaticResource HexColorToBrush}}"
                               FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6" />
                </Border>
                <Border Background="#FF1D2027" ClipToBounds="True" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="{Binding ImagePath, Converter={StaticResource FilePathToImageSource}}" Stretch="Fill"
                           Width="{Binding ContentWidth}" Height="{Binding ContentHeight}" Margin="{Binding ContentMargin}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Border>
                <Border Background="#FF1D2027" ClipToBounds="True" Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="{Binding LiveFrame}" Stretch="Fill"
                           Width="{Binding ContentWidth}" Height="{Binding ContentHeight}" Margin="{Binding ContentMargin}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- This window is the local render surface (docs/OUTPUT.md): the intended way for TikTok
         Studio/OBS on this PC to get the production is to Window/Display-capture this window,
         not for TradeFix to stream pixels itself. -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Stage" Width="960" Height="540" Background="#FF0B0C10" ClipToBounds="True">
            <TextBlock Text="Waiting for scene from Master…" Foreground="#FF8A8F9C" FontSize="18"
                       Canvas.Left="20" Canvas.Top="20"
                       Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource RenderSourceTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</Window>
