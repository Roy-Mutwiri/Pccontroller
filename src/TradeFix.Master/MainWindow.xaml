<Window x:Class="TradeFix.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TradeFix.Master"
        xmlns:conv="clr-namespace:TradeFix.Master.Converters"
        xmlns:vm="clr-namespace:TradeFix.Master.ViewModels"
        mc:Ignorable="d"
        Title="TradeFix Broadcast Control Center" Height="860" Width="1500"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <conv:ResourceKeyToBrushConverter x:Key="StatusBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:HexColorToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSource" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />

        <DataTemplate x:Key="NodeCardTemplate" DataType="{x:Type vm:NodeViewModel}">
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="16" Margin="0,0,12,12" Width="230">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="18" ShadowDepth="0" Opacity="0.12" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrushKey, Converter={StaticResource StatusBrush}}"
                                 Style="{StaticResource Ellipse.Pulse}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Text.Secondary}" Margin="18,2,0,0" />
                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrushKey, Converter={StaticResource StatusBrush}}"
                               FontWeight="Bold" FontSize="11" Margin="18,4,0,10" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Secondary}" Text="CPU" />
                        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                            <Run Text="{Binding CpuPercent, StringFormat={}{0:0}}" /><Run Text="%" />
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Secondary}" Text="GPU" />
                        <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right">
                            <Run Text="{Binding GpuPercent, StringFormat={}{0:0}}" /><Run Text="%" />
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Secondary}" Text="RAM" />
                        <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right">
                            <Run Text="{Binding RamPercent, StringFormat={}{0:0}}" /><Run Text="%" />
                        </TextBlock>
                    </Grid>

                    <Separator Margin="0,10,0,8" Opacity="0.15" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="FPS" />
                            <TextBlock Text="{Binding Fps, StringFormat={}{0:0.0}}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="LATENCY" />
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding LatencyMs, StringFormat={}{0:0.0}}" /><Run Text=" ms" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding IpAddress}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SourceItemTemplate" DataType="{x:Type vm:SourceItemViewModel}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Border x:Name="Box"
                        MouseLeftButtonDown="SourceItem_MouseLeftButtonDown"
                        MouseMove="SourceItem_MouseMove"
                        MouseLeftButtonUp="SourceItem_MouseLeftButtonUp"
                        Cursor="SizeAll">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="White" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="BorderThickness" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                Visibility="{Binding IsColor, Converter={StaticResource BoolToVisibility}}" />
                        <Border Background="#AA000000" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TextContent}" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                       FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6" />
                        </Border>
                        <Border Background="#FF1D2027" ClipToBounds="True" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding ImagePath, Converter={StaticResource FilePathToImageSource}}" Stretch="Fill"
                                   Width="{Binding ContentWidth}" Height="{Binding ContentHeight}" Margin="{Binding ContentMargin}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Border>
                        <Border Background="#FF1D2027" ClipToBounds="True" Visibility="{Binding IsCapture, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <!-- Master already has the captured bytes in-process, so it shows the same live preview it sends to nodes. -->
                                <Image Source="{Binding LiveFrame}" Stretch="Fill"
                                       Width="{Binding ContentWidth}" Height="{Binding ContentHeight}" Margin="{Binding ContentMargin}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Visibility="{Binding LiveFrame, Converter={StaticResource NullToVisibility}}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding LiveFrame, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                                    <Ellipse Width="12" Height="12" Fill="{StaticResource Brush.Danger}" Style="{StaticResource Ellipse.Pulse}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Connecting…" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,6,0,0" />
                                </StackPanel>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#CC000000" Padding="6,3" Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Danger}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" FontWeight="Bold" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Crop drag handles: shown only on the selected source, when its type supports
                     crop. Fixed at the box's own edges (same approach as OBS's crop tool) — drag
                     one inward and that edge's crop fraction increases; the content re-scales
                     live to show the cropped region, no typing required. -->
                <Rectangle Width="8" Fill="{StaticResource Brush.Accent}" Opacity="0.85"
                           HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-4,0,0,0"
                           Cursor="SizeWE" Tag="Left"
                           Visibility="{Binding ShowCropHandles, Converter={StaticResource BoolToVisibility}}"
                           MouseLeftButtonDown="CropHandle_MouseLeftButtonDown"
                           MouseMove="CropHandle_MouseMove"
                           MouseLeftButtonUp="CropHandle_MouseLeftButtonUp" />
                <Rectangle Width="8" Fill="{StaticResource Brush.Accent}" Opacity="0.85"
                           HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,-4,0"
                           Cursor="SizeWE" Tag="Right"
                           Visibility="{Binding ShowCropHandles, Converter={StaticResource BoolToVisibility}}"
                           MouseLeftButtonDown="CropHandle_MouseLeftButtonDown"
                           MouseMove="CropHandle_MouseMove"
                           MouseLeftButtonUp="CropHandle_MouseLeftButtonUp" />
                <Rectangle Height="8" Fill="{StaticResource Brush.Accent}" Opacity="0.85"
                           HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,-4,0,0"
                           Cursor="SizeNS" Tag="Top"
                           Visibility="{Binding ShowCropHandles, Converter={StaticResource BoolToVisibility}}"
                           MouseLeftButtonDown="CropHandle_MouseLeftButtonDown"
                           MouseMove="CropHandle_MouseMove"
                           MouseLeftButtonUp="CropHandle_MouseLeftButtonUp" />
                <Rectangle Height="8" Fill="{StaticResource Brush.Accent}" Opacity="0.85"
                           HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                           Cursor="SizeNS" Tag="Bottom"
                           Visibility="{Binding ShowCropHandles, Converter={StaticResource BoolToVisibility}}"
                           MouseLeftButtonDown="CropHandle_MouseLeftButtonDown"
                           MouseMove="CropHandle_MouseMove"
                           MouseLeftButtonUp="CropHandle_MouseLeftButtonUp" />

                <Button Content="✕" Click="DeleteSourceButton_Click"
                        Width="20" Height="20" Padding="0" FontSize="11"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0"
                        Background="{StaticResource Brush.Danger}" BorderThickness="0"
                        ToolTip="Delete this source" />

                <Rectangle Width="14" Height="14" Fill="White" Stroke="Black" StrokeThickness="1"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-7,-7"
                           Cursor="SizeNWSE"
                           MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                           MouseMove="ResizeHandle_MouseMove"
                           MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.WindowBackdrop}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Faint HUD grid, full-bleed behind everything -->
        <Rectangle Grid.RowSpan="3" Fill="{StaticResource Brush.GridOverlay}" IsHitTestVisible="False" />

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}">
            <Grid>
                <DockPanel Margin="20,12">
                    <TextBlock Text="TradeFix Broadcast Control Center" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerSummary}" Style="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left" />
                </DockPanel>
                <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource Brush.AccentLine}">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
                    </Border.Effect>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- Left nav: scenes -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,12">
                    <TextBlock Text="SCENES" Padding="16,10" DockPanel.Dock="Top" Style="{StaticResource Text.Eyebrow}" />
                    <Button Content="+ Add Scene" DockPanel.Dock="Bottom" Margin="12" Command="{Binding AddSceneCommand}" />

                    <ItemsControl ItemsSource="{Binding Scenes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SceneItemViewModel}">
                                <Border Padding="16,10" Cursor="Hand"
                                        MouseLeftButtonDown="SceneItem_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="AUDIO · not yet built" Padding="16,20,16,10" Style="{StaticResource Text.Secondary}" DockPanel.Dock="Top" />
                    <TextBlock Text="OUTPUT · not yet built" Padding="16,0,16,10" Style="{StaticResource Text.Secondary}" DockPanel.Dock="Top" />
                </DockPanel>
            </Border>

            <!-- Center: program canvas + node dashboard -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Pair New Node" Style="{StaticResource Button.Primary}" Command="{Binding PairNewNodeCommand}" Margin="0,0,8,0" />
                            <Button Content="Add Simulated Node" Command="{Binding AddSimulatedNodeCommand}" />
                        </StackPanel>
                        <TextBlock Text="TradeFix Broadcast Control Center" Style="{StaticResource Text.Heading}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0"
                            Visibility="{Binding ActivePairingCode, Converter={StaticResource NullToVisibility}}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="20" ShadowDepth="0" Opacity="0.35" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Connect code — copy this and paste it into the TradeFix Render Agent on the other PC:" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                            <DockPanel Margin="0,4,0,0">
                                <Button Content="Copy" Command="{Binding CopyConnectCodeCommand}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActivePairingCode}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="Valid for 30 minutes. Nothing else needs to be typed on the other PC." Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Warning}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,14,0,0"
                            Visibility="{Binding StartupWarning, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding StartupWarning}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" />
                    </Border>

                    <!-- PROGRAM: add/drag/resize sources here — every connected node mirrors the active scene live. -->
                    <DockPanel Margin="0,24,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="+ Color Box" Command="{Binding AddColorSourceCommand}" Margin="0,0,8,0" />
                            <Button Content="+ Text" Command="{Binding AddTextSourceCommand}" Margin="0,0,8,0" />
                            <Button Content="+ Image" Command="{Binding AddImageSourceCommand}" Margin="0,0,8,0" />
                            <Button Content="+ App Capture" Command="{Binding AddCaptureSourceCommand}" Margin="0,0,8,0" />
                            <Button Content="+ Browser" Command="{Binding AddBrowserSourceCommand}" Margin="0,0,8,0" />
                            <Button Content="+ Full Screen" Command="{Binding AddFullScreenCaptureSourceCommand}" />
                        </StackPanel>
                        <TextBlock Text="Program" Style="{StaticResource Text.Heading}" />
                    </DockPanel>
                    <Grid HorizontalAlignment="Left">
                        <!-- Static decorative glow behind the frame — kept off the live canvas itself
                             so the Effect's bitmap cache never has to re-rasterize per captured frame. -->
                        <Border Background="{StaticResource Brush.Accent}" Opacity="0.12" CornerRadius="12" Margin="-8">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="26" ShadowDepth="0" Opacity="0.5" />
                            </Border.Effect>
                        </Border>

                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="1">
                            <Viewbox Width="720" Height="405" Stretch="Uniform">
                                <Canvas x:Name="ProgramCanvas" Width="960" Height="540" Background="#FF0B0C10" ClipToBounds="True"
                                        MouseLeftButtonDown="ProgramCanvas_MouseLeftButtonDown">
                                    <ItemsControl ItemsSource="{Binding ActiveSceneSources}" ItemTemplate="{StaticResource SourceItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- HUD corner brackets -->
                        <Path Data="M0,16 L0,0 L16,0" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0" IsHitTestVisible="False" />
                        <Path Data="M0,0 L16,0 L16,16" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" IsHitTestVisible="False" />
                        <Path Data="M0,0 L0,16 L16,16" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3" IsHitTestVisible="False" />
                        <Path Data="M0,16 L16,16 L16,0" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="Click a box to select it (Properties panel on the right). Drag to move; drag the white corner square to resize. For Image/App Capture sources, drag the accent-colored bars on the edges to crop. Every connected node updates live." Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="Nodes" Style="{StaticResource Text.Heading}" Margin="0,28,0,10" />
                    <ItemsControl ItemsSource="{Binding Nodes}" ItemTemplate="{StaticResource NodeCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: properties panel for the selected source -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
                <StackPanel Margin="16">
                    <TextBlock Text="Properties" Style="{StaticResource Text.Heading}" Margin="0,0,0,14" />

                    <StackPanel Visibility="{Binding SelectedSource, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding SelectedSource.Name}" FontWeight="SemiBold" Margin="0,0,0,14" />

                        <StackPanel Visibility="{Binding SelectedSource.IsText, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Text" Style="{StaticResource Text.Secondary}" />
                            <TextBox Text="{Binding SelectedSource.TextContent, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70" Margin="0,4,0,10" Padding="6" />
                        </StackPanel>

                        <TextBlock Text="Color (hex)" Style="{StaticResource Text.Secondary}" />
                        <TextBox Text="{Binding SelectedSource.ColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="6" />

                        <Button Content="Apply" Style="{StaticResource Button.Primary}" Command="{Binding ApplySelectedSourcePropertiesCommand}" Margin="0,4,0,10" />

                        <!-- Crop: Image and Capture sources only. Percentages trimmed from each edge. -->
                        <StackPanel Visibility="{Binding SelectedSource.HasCrop, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <Separator Margin="0,0,0,10" Opacity="0.15" />
                            <TextBlock Text="Crop (%)" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                            <TextBlock Text="Drag the accent-colored bars on the source's edges in Program for fast, direct crop. These fields update live and are only needed for exact values." Style="{StaticResource Text.Secondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,6">
                                    <TextBlock Text="Left" Style="{StaticResource Text.Secondary}" FontSize="10" />
                                    <TextBox Text="{Binding SelectedSource.CropLeft, Converter={StaticResource FractionToPercent}}" Padding="4" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,6">
                                    <TextBlock Text="Top" Style="{StaticResource Text.Secondary}" FontSize="10" />
                                    <TextBox Text="{Binding SelectedSource.CropTop, Converter={StaticResource FractionToPercent}}" Padding="4" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Right" Style="{StaticResource Text.Secondary}" FontSize="10" />
                                    <TextBox Text="{Binding SelectedSource.CropRight, Converter={StaticResource FractionToPercent}}" Padding="4" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Bottom" Style="{StaticResource Text.Secondary}" FontSize="10" />
                                    <TextBox Text="{Binding SelectedSource.CropBottom, Converter={StaticResource FractionToPercent}}" Padding="4" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Apply Crop" Style="{StaticResource Button.Primary}" Command="{Binding ApplySelectedSourceCropCommand}" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- Capture-only: frame rate / quality, restarts the capture with new settings. -->
                        <StackPanel Visibility="{Binding SelectedSource.IsCapture, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <Separator Margin="0,0,0,10" Opacity="0.15" />
                            <TextBlock Text="Capture settings" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                            <TextBlock Text="Frame rate (FPS)" Style="{StaticResource Text.Secondary}" FontSize="10" />
                            <TextBox Text="{Binding SelectedSource.CaptureFps}" Margin="0,2,0,8" Padding="4" />
                            <TextBlock Text="Max dimension (px) — 3840 (4K) by default so nothing gets downscaled; lower only to trade quality for bandwidth" Style="{StaticResource Text.Secondary}" FontSize="10" TextWrapping="Wrap" />
                            <TextBox Text="{Binding SelectedSource.CaptureMaxDimension}" Margin="0,2,0,8" Padding="4" />
                            <TextBlock Text="JPEG quality (1-100) — 100 is the highest this format supports" Style="{StaticResource Text.Secondary}" FontSize="10" TextWrapping="Wrap" />
                            <TextBox Text="{Binding SelectedSource.CaptureQuality}" Margin="0,2,0,8" Padding="4" />
                            <CheckBox Content="Include audio (desktop sound, not isolated to just this app)"
                                      IsChecked="{Binding SelectedSource.CaptureIncludeAudio}"
                                      Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,10" />
                            <Button Content="Apply Capture Settings" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCaptureSettingsCommand}" />

                            <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Warning}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,10,0,0"
                                    Visibility="{Binding SelectedSource.AdaptiveStatusText, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding SelectedSource.AdaptiveStatusText}" Foreground="{StaticResource Brush.Warning}"
                                           FontSize="10" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <Button Content="Delete Source" Click="DeleteSelectedSourceButton_Click" Margin="0,14,0,0"
                                ToolTip="Remove this source from the scene (Delete key also works)" />

                        <Separator Margin="0,16,0,16" Opacity="0.15" />
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap">
                            <Run Text="Position:" /> <Run Text="{Binding SelectedSource.X, Mode=OneWay, StringFormat={}{0:0}}" />
                            <Run Text="," /> <Run Text="{Binding SelectedSource.Y, Mode=OneWay, StringFormat={}{0:0}}" />
                            <LineBreak />
                            <Run Text="Size:" /> <Run Text="{Binding SelectedSource.Width, Mode=OneWay, StringFormat={}{0:0}}" />
                            <Run Text="×" /> <Run Text="{Binding SelectedSource.Height, Mode=OneWay, StringFormat={}{0:0}}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="Nothing selected. Click a box in Program, or add one with + Color Box / + Text."
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                               Visibility="{Binding SelectedSource, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log panel -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}">
            <Grid>
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Brush.AccentLine}" Opacity="0.5" />
                <DockPanel Margin="16,10">
                    <TextBlock Text="LOGS" Style="{StaticResource Text.Eyebrow}" DockPanel.Dock="Top" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding RecentLogLines}" FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
