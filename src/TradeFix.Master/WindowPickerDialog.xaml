<Window x:Class="TradeFix.Master.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an app to capture" Height="480" Width="480"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackdrop}">
    <Grid Background="{StaticResource Brush.WindowBackdrop}">
        <Rectangle Fill="{StaticResource Brush.AmbientGlow}" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource Brush.GridOverlay}" IsHitTestVisible="False" />
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Pick the window to capture live — its content will stream to every connected node."
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <ListBox x:Name="WindowList" Background="Transparent" BorderThickness="0"
                         DisplayMemberPath="Title"
                         MouseDoubleClick="WindowList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                <!-- Disabled until something is selected — the old silent no-op on click read as
                     a broken button. IsDefault makes Enter commit the highlighted row. -->
                <Button Content="Capture Selected" IsDefault="True" Click="Select_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=WindowList}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
