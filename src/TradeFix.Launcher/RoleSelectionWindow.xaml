<Window x:Class="TradeFix.Launcher.RoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TradeFix Broadcast — Set up this PC" Height="380" Width="520"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="{StaticResource Brush.WindowBackdrop}">
        <Rectangle Fill="{StaticResource Brush.GridOverlay}" IsHitTestVisible="False" />

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="What is this PC?" Style="{StaticResource Text.Heading}" FontSize="22" />
            <TextBlock Grid.Row="1" Margin="0,8,0,24" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}">
                Pick one Master PC to control the production. Every other PC is a Render Node that
                mirrors what the Master shows. You can change this later from the tray icon.
            </TextBlock>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource Brush.Surface}" BorderThickness="1" CornerRadius="10"
                        Padding="20" Width="200" Margin="0,0,12,0"
                        Cursor="Hand" MouseLeftButtonUp="MasterCard_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Master PC" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Accent}" />
                        <TextBlock Text="Controls the scene, sources, and layout. Other PCs mirror this one."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,16"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button Content="This is the Master PC" Style="{StaticResource Button.Primary}"
                                Click="MasterButton_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Brush.Surface}" BorderThickness="1" CornerRadius="10"
                        Padding="20" Width="200"
                        Cursor="Hand" MouseLeftButtonUp="RenderNodeCard_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="{StaticResource Color.Accent}" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Render Node" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="Mirrors the Master PC's production live. Needs the Master's connect code."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,16"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button Content="This is a Render Node" Click="RenderNodeButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Only one PC should be the Master." Style="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center" Margin="0,20,0,0" />
        </Grid>
    </Grid>
</Window>
