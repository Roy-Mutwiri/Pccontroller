<Window x:Class="TradeFix.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TradeFix Broadcast Setup" Height="420" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Rectangle Fill="{StaticResource Brush.GridOverlay}" IsHitTestVisible="False" />
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource Text.Heading}" FontSize="20" />
            <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,6,0,16" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />

            <ListBox x:Name="LogList" Grid.Row="2" Background="{StaticResource Brush.Surface}"
                     BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                     FontFamily="Consolas" FontSize="12" Padding="8" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
